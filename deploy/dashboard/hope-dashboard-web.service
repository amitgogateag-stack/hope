[Unit]
Description=HOPE private read-only dashboard on loopback
After=network.target

[Service]
Type=simple
User=hope-dashboard
Group=hope-dashboard
WorkingDirectory=/opt/hope
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONUSERBASE PYTHONWARNINGS PYTHONINSPECT PYTHONSTARTUP PYTHONBREAKPOINT PYTHONPLATLIBDIR LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
ExecStart=/usr/bin/env PYTHONPATH=/opt/hope/src /opt/hope/.venv/bin/python -m hope.api.dashboard_server --port 8787 --preview /opt/hope/docs/dashboard/preview.html --snapshot /var/lib/hope-dashboard/snapshot.json
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
