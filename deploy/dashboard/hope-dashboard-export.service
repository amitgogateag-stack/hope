[Unit]
Description=HOPE dashboard read-only PostgreSQL snapshot export
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=hope-dashboard
Group=hope-dashboard
WorkingDirectory=/opt/hope
Environment=PYTHONPATH=/opt/hope/src
EnvironmentFile=/etc/hope-dashboard.env
ExecStart=/opt/hope/.venv/bin/python -m hope.api.dashboard_snapshot --output /var/lib/hope-dashboard/snapshot.json
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/hope-dashboard
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
