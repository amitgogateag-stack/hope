[Unit]
Description=HOPE autonomous PAPER operations (LIVE disabled)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=15min
User=hope-paper
Group=hope-operations
WorkingDirectory=/opt/hope-operations/current
EnvironmentFile=/etc/hope-paper.env
EnvironmentFile=/opt/hope-operations/deployed.env
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONUSERBASE PYTHONWARNINGS PYTHONINSPECT PYTHONSTARTUP PYTHONBREAKPOINT PYTHONPLATLIBDIR LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
ExecStartPre=/usr/bin/python3 -I -B -S -X pycache_prefix=/nonexistent/hope-runtime-bootstrap /opt/hope-operations/current/deploy/operations/paper_release.py --preflight
ExecStart=/usr/bin/python3 -I -B -S -X pycache_prefix=/nonexistent/hope-runtime-bootstrap /opt/hope-operations/current/deploy/operations/paper_release.py --factory ${HOPE_PAPER_FACTORY} --migrations-dir /opt/hope-operations/current/migrations --status-file /var/lib/hope-paper/health.json --poll-seconds 30 --deployment-receipt ${HOPE_DEPLOYMENT_RECEIPT} --controller-directory /var/lib/hope-controller
# Recover even when the worker handles an unexpected signal and exits cleanly.
# An explicit systemctl stop suppresses restart at the manager boundary.
Restart=always
RestartSec=15s
# READY is withheld until the first complete verified cycle. Keep startup
# bounded by the same operational ceiling as the watchdog/recovery contract.
TimeoutStartSec=15min
TimeoutStopSec=60s
KillSignal=SIGTERM
KillMode=control-group
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/hope-paper
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryMax=1G
TasksMax=64
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hope-paper
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
